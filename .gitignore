# ─── Rust ─────────────────────────────────────────────────────────────────────
/target/
**/*.rs.bk
# Cargo.lock is committed for binaries (deterministic CI builds)

# ─── Python ───────────────────────────────────────────────────────────────────
openpika-python/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
openpika-python/dist/
openpika-python/.ruff_cache/
openpika-python/.mypy_cache/
openpika-python/.pytest_cache/

# ─── Next.js / Node ───────────────────────────────────────────────────────────
openpika-ui/.next/
openpika-ui/node_modules/
openpika-ui/out/
openpika-ui/.vercel/
openpika-ui/tsconfig.tsbuildinfo

# ─── Secrets & local config ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Database files ───────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
*.msi
*.dmg
*.pkg

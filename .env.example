# Copy to .env and fill in your values
# Never commit a populated .env file.

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Database (default: SQLite at ~/.openpika/state.db)
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql://openpika:password@localhost:5432/openpika

# Log level: trace, debug, info, warn, error
OPENPIKA_LOG_LEVEL=info

# Enterprise SSO (fill in one or more providers in config.toml)
# OKTA_CLIENT_SECRET=...
# AZURE_CLIENT_SECRET=...
# AUTH0_CLIENT_SECRET=...
